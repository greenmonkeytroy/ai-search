# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Postgres connection string used by ingest.py and search.py
DATABASE_URL=postgresql://postgres@localhost/search_proto

# OpenAI API key — only needed if you switch embed_text() in embeddings.py
# to the OpenAI alternative. The default text embedding model runs locally.
OPENAI_API_KEY=sk-your-key-here
