{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run search API (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["search:app", "--reload", "--port", "8000"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Run ingestion (sample_data.csv)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ingest.py",
      "args": ["sample_data.csv"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
